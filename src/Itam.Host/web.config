<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\Itam.Host.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Windows sign-in: every request is authenticated by IIS; nobody types a password in IT Assets. -->
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true" />
        </authentication>
        <!-- Uploads (signed delivery notes, invoices, quotations) up to 10 MB plus the form. -->
        <requestFiltering><requestLimits maxAllowedContentLength="12582912" /></requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
