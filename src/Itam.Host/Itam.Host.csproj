<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- IT Assets production host: its own IIS site (test and production), Windows sign-in, the company SQL Server, Active
       Directory read over LDAPS as the site's identity, the company mail relay. No passwords in its settings. -->
  <PropertyGroup>
    <AssemblyName>Itam.Host</AssemblyName>
    <!-- IIS on Windows Server only (Windows sign-in, DPAPI key protection). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Itam.App\Itam.App.csproj" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.13" />
  </ItemGroup>
</Project>
